{
  "name": "discord-status-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-Bot mit Status- und Regelportal",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "latest",
    "@fastify/static": "latest",
    "discord.js": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "fastify": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
